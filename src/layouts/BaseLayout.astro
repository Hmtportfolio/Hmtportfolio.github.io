---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Lightbox from '../components/Lightbox.astro';
import type { PortfolioData } from '../data/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'vi';
  canonicalUrl: string;
  data: PortfolioData;
}

const { title, description, lang, canonicalUrl, data } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Multi-language SEO hreflang links -->
  <link rel="alternate" hreflang="en" href="https://hmtportfolio.github.io/" />
  <link rel="alternate" hreflang="vi" href="https://hmtportfolio.github.io/vn/" />
  <link rel="alternate" hreflang="x-default" href="https://hmtportfolio.github.io/" />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%231a1a1a'/%3E%3Ccircle cx='50' cy='27' r='9' fill='%23d97706'/%3E%3Ctext x='50' y='76' font-family='Arial, sans-serif' font-size='44' font-weight='700' fill='white' text-anchor='middle'%3EH%3C/text%3E%3C/svg%3E" />

  <!-- R2 Media Preconnect -->
  <link rel="preconnect" href="https://pub-58ba3247d6ee441b9218b20100871e4c.r2.dev" />

  <!-- Self-Hosted Inter Variable Font Preload (Instant Zero-CLS Text Render) -->
  <link rel="preload" href="/fonts/inter/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  {lang === 'vi' && (
    <link rel="preload" href="/fonts/inter/inter-vietnamese.woff2" as="font" type="font/woff2" crossorigin />
  )}

  <!-- Prevent Theme Flash (FOUC) synchronously in head -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored === 'dark' || stored === 'light'
        ? stored
        : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <div class="app">
    <Header nav={data.nav} currentLang={lang} />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer footer={data.footer} />
  </div>

  <ProjectModal />
  <Lightbox />

  <!-- Ultra-lightweight modular client islands (< 5 KB bundled) -->
  <script>
    import { setupTabs } from '../scripts/tabs';
    import { setupProjectFilter } from '../scripts/filter';
    import { setupThemeToggle } from '../scripts/theme';
    import { setupModalAndLightbox } from '../scripts/modal';
    import { setupLazyThumbVideos } from '../scripts/lazy-video';

    // Initialize interactive DOM controllers
    setupTabs();
    setupProjectFilter();
    setupThemeToggle(document.getElementById('theme-toggle'));
    setupModalAndLightbox();
    setupLazyThumbVideos();

    // Cache-first service worker for Cloudflare R2 media assets (production only)
    if (import.meta.env.PROD && 'serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
      });
    }
  </script>
</body>
</html>
